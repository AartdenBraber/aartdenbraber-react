# Instellingen voor scripts/server_*.py: beheer van de server vanaf je eigen
# machine. De uitrol gebruikt dit bestand niet; die heeft een eigen FTP-account
# met de gegevens in GitHub.
#
# Kopieer dit bestand naar .env.server en vul het daar in. .env.server staat in
# .gitignore en hoort daar te blijven: er komt een echt wachtwoord in.
#
# Zet deze gegevens niet in .env. Dat bestand staat wel in git, en de repo is
# openbaar. Een variabele die al in je omgeving staat, wint van wat hier staat.


# Vaste waarden bij Versio. Poort 21 met expliciete TLS; SSH en SFTP staan uit.
AADB_FTP_HOST=vserver99.axc.eu
AADB_FTP_PORT=21

# Een eigen FTP-account voor beheer, niet dat van de uitrol. Maak het aan in
# DirectAdmin onder FTP-beheer en kies als map
#
#   /home/aartdenbraber/domains/aartdenbraber.nl
#
# dus één niveau boven public_html. Alleen dan kan het ook bij
# contactformulier/config.php. De gebruikersnaam is inclusief
# @aartdenbraber.nl.
AADB_FTP_USER=
AADB_FTP_PASS=
