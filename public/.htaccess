# Dit bestand stond alleen op de server en niet in de repo, waardoor niemand
# kon zien waarom /en werkte. Het gaat nu mee met de build.

RewriteEngine On
RewriteBase /

# www doorsturen naar het kale domein. Zonder dit staat de site op twee
# adressen en ziet een zoekmachine dubbele inhoud. Deze regel moet boven de
# fallback hieronder staan, anders vangt die hem eerder af.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# /en krijgt zijn eigen html met de Engelse titel, omschrijving en canonical,
# en met lang="en". Het is dezelfde app; dit is alleen de kop van het document.
# Wie geen javascript draait, zoals het deelvenster van LinkedIn, zag daar
# anders de Nederlandse tekst. Deze regel moet boven de fallback hieronder
# staan, anders vangt die hem eerder af. scripts/maak-en-pagina.js zet het
# bestand bij elke build klaar.
RewriteRule ^en/?$ /en.html [L]

# De kern: alles wat geen bestaand bestand of map is, krijgt index.html terug.
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
  # Afbeeldingen en de cv's veranderen zonder dat hun naam verandert, dus die
  # mogen maar een dag bewaard blijven. Anders zie je een nieuw cv pas als de
  # browser toevallig besluit opnieuw te kijken.
  <FilesMatch "\.(pdf|jpe?g|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Bestanden met een hash in hun naam zijn onveranderlijk: verandert de
  # inhoud, dan verandert de naam. Die mogen dus een jaar blijven staan. Deze
  # regel staat bewust na de vorige, zodat hij daarvan wint.
  <FilesMatch "\.[0-9a-f]{8,}\.(js|css|woff2?|ttf|eot|png|jpe?g|svg|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Beide toegangsdocumenten moeten elke keer opnieuw gecontroleerd worden,
  # anders blijft een bezoeker na een uitrol naar de oude bestandsnamen
  # verwijzen. en.html hoort er net zo goed bij als index.html: zonder deze
  # regel bewaart de browser hem heuristisch en wijst /en na een uitrol naar
  # bundels die er niet meer zijn.
  <FilesMatch "^(index|en)\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # De cv's blijven gewoon te downloaden, maar horen niet in de zoekresultaten:
  # er staat een e-mailadres in en dat wordt geoogst. De pagina zelf blijft wel
  # geindexeerd.
  #
  # robots.txt zet er daarnaast een Disallow op. Die twee bijten elkaar deels:
  # wie het bestand niet mag ophalen, ziet deze header ook nooit. Dat is een
  # bewuste keuze, want de Disallow sluit ook de tweede route af: het cv wordt
  # met javascript getekend en de tekstlaag komt uit dit bestand, dus zonder
  # ophalen bestaat die tekst ook niet voor een zoekmachine. Deze header blijft
  # staan voor wie de pdf wel ophaalt zonder robots.txt te lezen. Restrisico:
  # een pdf-url die van buitenaf gelinkt wordt, kan als kale vermelding zonder
  # inhoud in de resultaten blijven staan; de downloadknop heeft daarom
  # rel=nofollow.
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>
